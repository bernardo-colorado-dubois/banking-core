# Copiar a .env y ajustar valores. El archivo .env no se sube al repositorio.

# PostgreSQL
POSTGRES_USER=core_bancario
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=core_bancario
POSTGRES_PORT=5432

# Aplicación
DATABASE_URL=postgresql+psycopg://core_bancario:cambiar_esta_password@localhost:5432/core_bancario
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRACION_MINUTOS=20
PORT=8080
BANCO_NOMBRE=Nombre del banco

# Primer admin (create_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar_esta_password
